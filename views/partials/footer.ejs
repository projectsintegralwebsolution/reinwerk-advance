<!-- Scroll to Top ("Bottom to Top") Floating Button -->
<button id="scrollToTopBtn" class="scroll-top-btn" aria-label="<%= currentLang === 'de' ? 'Nach oben scrollen' : 'Scroll to top' %>" title="<%= currentLang === 'de' ? 'Nach oben scrollen' : 'Scroll to top' %>">
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="18 15 12 9 6 15"></polyline>
  </svg>
  <span class="scroll-top-text">TOP</span>
</button>

<!-- Toast Container -->
