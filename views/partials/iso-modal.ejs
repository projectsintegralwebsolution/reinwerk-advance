<!-- ISO 14644 vs EU-GMP Classification Modal -->
<div class="modal-overlay" id="isoGuideModal" role="dialog" aria-modal="true" aria-labelledby="isoModalTitle">
  <div class="modal-container">
    <div class="modal-header">
      <div>
        <h3 id="isoModalTitle">ISO 14644-1:2015 vs. EU-GMP Annex 1 Classification Guide</h3>
        <p style="font-size:13px; color:var(--slate-500); margin-top:2px;">
          Cleanroom particle concentration limits (per m³) & engineering design requirements
        </p>
      </div>
      <button class="modal-close-btn" data-close-iso-modal aria-label="Close modal">&times;</button>
    </div>
    <div class="modal-body">
      <div style="overflow-x:auto;">
        <table class="spec-table" style="width:100%; border-collapse:collapse; min-width:680px;">
          <thead>
            <tr style="background:var(--slate-100); text-align:left; border-bottom:2px solid var(--slate-300);">
              <th style="padding:10px 12px; font-size:12px; color:var(--slate-700);">ISO Class</th>
              <th style="padding:10px 12px; font-size:12px; color:var(--slate-700);">Fed. Std. 209E</th>
              <th style="padding:10px 12px; font-size:12px; color:var(--slate-700);">EU-GMP Grade</th>
              <th style="padding:10px 12px; font-size:12px; color:var(--slate-700);">≥ 0.5 µm (m³)</th>
              <th style="padding:10px 12px; font-size:12px; color:var(--slate-700);">≥ 5.0 µm (m³)</th>
              <th style="padding:10px 12px; font-size:12px; color:var(--slate-700);">Air Changes (ACH)</th>
              <th style="padding:10px 12px; font-size:12px; color:var(--slate-700);">Filter Standard</th>
              <th style="padding:10px 12px; font-size:12px; color:var(--slate-700);">Primary Application</th>
            </tr>
          </thead>
          <tbody id="isoComparisonTableBody">
            <!-- Dynamically populated via /js/iso-guide.js -->
          </tbody>
        </table>
      </div>
      
      <div style="margin-top:24px; padding:16px; background:var(--clean-blue-light); border-radius:var(--radius-md); font-size:13px; color:var(--primary-navy-dark);">
        <strong>Engineering Note:</strong> REINWERK customizes airflow velocity and filter coverage based on specific room geometry and process heat dissipation. For assistance selecting your target classification, our senior cleanroom consultants are available for technical audits.
      </div>
      
      <div style="margin-top:20px; text-align:right;">
        <a href="/quote" class="btn btn-accent btn-sm">Configure Cleanroom with This Guide</a>
        <button class="btn btn-outline btn-sm" data-close-iso-modal style="margin-left:8px;">Close</button>
      </div>
    </div>
  </div>
</div>
