<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <span>Industries</span>
      </div>
      <div class="page-hero-content">
        <span class="eyebrow" style="color:#38bdf8;">Sector Expertise</span>
        <h1>Cleanroom Engineering by Industry</h1>
        <p>
          Contamination requirements vary drastically between aseptic pharmaceutical filling and sub-micron semiconductor lithography. We design every cleanroom to your specific regulatory framework.
        </p>
      </div>
    </div>
  </section>

  <!-- Industries Deep-Dive -->
  <section class="section">
    <div class="container">
      <div style="display:flex; flex-direction:column; gap:64px;">
        <% industries.forEach((ind, index) => { %>
          <div id="<%= ind.slug %>" class="card" style="padding:40px; border-top: 4px solid var(--primary-navy);">
            <div style="display:grid; grid-template-columns: 1.2fr 0.8fr; gap:40px; align-items:start;">
              <div>
                <div style="display:flex; align-items:center; gap:12px; margin-bottom:12px;">
                  <span class="deliverable-tag" style="background:var(--clean-blue-light); color:var(--primary-navy); font-weight:700;">
                    <%= ind.isoClass %>
                  </span>
                  <span class="deliverable-tag" style="background:#fee2e2; color:var(--accent-red); font-weight:700;">
                    <%= ind.gmpGrade %>
                  </span>
                </div>
                <h2 style="font-size:2rem; color:var(--slate-900); margin-bottom:16px;"><%= ind.title %></h2>
                <p style="font-size:1.0625rem; color:var(--slate-600); margin-bottom:28px; line-height:1.7;">
                  <%= ind.shortDescription %>
                </p>

                <!-- Challenges & Solutions Split -->
                <div class="grid-2" style="margin-bottom:28px;">
                  <div style="background:var(--slate-50); padding:20px; border-radius:var(--radius-md); border-left:3px solid var(--accent-red);">
                    <h4 style="font-size:1rem; margin-bottom:12px; color:var(--slate-900); display:flex; align-items:center; gap:6px;">
                      <i data-feather="alert-circle" style="width:16px; height:16px; color:var(--accent-red);"></i>
                      Sector Contamination Challenges
                    </h4>
                    <ul style="font-size:0.875rem; color:var(--slate-600); display:flex; flex-direction:column; gap:6px;">
                      <% ind.keyChallenges.forEach(c => { %>
                        <li style="display:flex; align-items:flex-start; gap:6px;">
                          <span style="color:var(--accent-red); font-weight:bold;">•</span>
                          <span><%= c %></span>
                        </li>
                      <% }) %>
                    </ul>
                  </div>

                  <div style="background:var(--clean-blue-light); padding:20px; border-radius:var(--radius-md); border-left:3px solid var(--primary-navy);">
                    <h4 style="font-size:1rem; margin-bottom:12px; color:var(--primary-navy-dark); display:flex; align-items:center; gap:6px;">
                      <i data-feather="check-circle" style="width:16px; height:16px; color:var(--primary-navy);"></i>
                      REINWERK Engineering Solutions
                    </h4>
                    <ul style="font-size:0.875rem; color:var(--slate-800); display:flex; flex-direction:column; gap:6px;">
                      <% ind.reinwerkSolutions.forEach(s => { %>
                        <li style="display:flex; align-items:flex-start; gap:6px;">
                          <span style="color:var(--primary-navy); font-weight:bold;">✓</span>
                          <span><%= s %></span>
                        </li>
                      <% }) %>
                    </ul>
                  </div>
                </div>

                <!-- Typical Applications & Standards -->
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:24px;">
                  <div>
                    <h4 style="font-size:0.875rem; text-transform:uppercase; color:var(--slate-500); margin-bottom:8px; font-weight:700;">Common Facility Types:</h4>
                    <div style="display:flex; flex-wrap:wrap; gap:6px;">
                      <% ind.typicalApplications.forEach(app => { %>
                        <span class="deliverable-tag"><%= app %></span>
                      <% }) %>
                    </div>
                  </div>
                  <div>
                    <h4 style="font-size:0.875rem; text-transform:uppercase; color:var(--slate-500); margin-bottom:8px; font-weight:700;">Applicable Regulatory Codes:</h4>
                    <div style="display:flex; flex-wrap:wrap; gap:6px;">
                      <% ind.complianceStandards.forEach(std => { %>
                        <span class="deliverable-tag" style="background:#e0e7ff; color:#3730a3; font-weight:600;"><%= std %></span>
                      <% }) %>
                    </div>
                  </div>
                </div>

                <a href="/quote" class="btn btn-primary btn-sm">
                  Request <%= ind.title %> Cleanroom Quote
                </a>
              </div>

              <!-- Industry Visual -->
              <div class="card-img-wrapper" style="height:380px; border-radius:var(--radius-lg);">
                <img src="<%= ind.heroImage %>" alt="<%= ind.title %>">
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Reusable CTA Consultation Banner -->
  <%- include('../partials/cta-banner') %>

  <!-- Footer -->
  <%- include('../partials/footer') %>
</body>
</html>
