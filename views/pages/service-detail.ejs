<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <%- include('../partials/header') %>

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/services">Services</a>
        <span>/</span>
        <span><%= service.title %></span>
      </div>
      <div class="page-hero-content">
        <span class="eyebrow" style="color:#38bdf8;"><%= service.isoRange %> • <%= service.gmpGrades %></span>
        <h1><%= service.heroHeadline %></h1>
        <p><%= service.heroSubheadline %></p>
      </div>
    </div>
  </section>

  <!-- Detailed Overview & Specs Box -->
  <section class="section">
    <div class="container">
      <div class="service-overview-grid">
        <!-- Overview Text & Features -->
        <div>
          <span class="eyebrow">Technical Overview</span>
          <h2 class="section-title">Engineered Contamination Control</h2>
          
          <% service.overview.forEach(p => { %>
            <p style="font-size:1.0625rem; color:var(--slate-700); margin-bottom:16px; line-height:1.7;">
              <%= p %>
            </p>
          <% }) %>

          <!-- Key Features Grid -->
          <h3 style="font-size:1.5rem; margin:36px 0 20px; color:var(--primary-navy);">Key Engineering Features</h3>
          <div class="grid-2">
            <% service.keyFeatures.forEach(feat => { %>
              <div style="background:var(--slate-50); padding:24px; border-radius:var(--radius-md); border:1px solid var(--slate-200);">
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
                  <i data-feather="<%= feat.icon %>" style="width:20px; height:20px; color:var(--accent-red);"></i>
                  <h4 style="font-size:1.0625rem; color:var(--slate-900);"><%= feat.title %></h4>
                </div>
                <p style="font-size:0.875rem; color:var(--slate-600); line-height:1.6;">
                  <%= feat.description %>
                </p>
              </div>
            <% }) %>
          </div>

          <!-- Process Workflow -->
          <h3 style="font-size:1.5rem; margin:40px 0 20px; color:var(--primary-navy);">Deployment & Delivery Lifecycle</h3>
          <div style="display:flex; flex-direction:column; gap:16px;">
            <% service.processSteps.forEach(st => { %>
              <div style="display:flex; gap:16px; align-items:flex-start; background:var(--white); border:1px solid var(--slate-200); padding:16px 20px; border-radius:var(--radius-md);">
                <span class="deliverable-tag" style="background:var(--primary-navy); color:var(--white); font-weight:700; font-size:0.875rem;"><%= st.step %></span>
                <div>
                  <div style="font-weight:700; color:var(--slate-900); font-size:1rem; margin-bottom:4px;"><%= st.title %></div>
                  <div style="font-size:0.875rem; color:var(--slate-600);"><%= st.description %></div>
                </div>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- Specifications Sidebar -->
        <div>
          <div class="spec-box">
            <h3 class="spec-box-title">Technical Specifications</h3>
            <table class="spec-table">
              <% service.specifications.forEach(spec => { %>
                <tr>
                  <td class="label"><%= spec.label %></td>
                  <td class="value"><%= spec.value %></td>
                </tr>
              <% }) %>
            </table>

            <div style="margin-top:28px;">
              <h4 style="font-size:0.9375rem; font-weight:700; margin-bottom:10px; color:var(--slate-800);">Typical Applications:</h4>
              <div style="display:flex; flex-wrap:wrap; gap:6px;">
                <% service.applications.forEach(app => { %>
                  <span class="deliverable-tag"><%= app %></span>
                <% }) %>
              </div>
            </div>

            <div style="margin-top:32px;">
              <a href="/quote" class="btn btn-accent" style="width:100%; text-align:center;">
                <i data-feather="file-text"></i>
                Request Custom Quotation
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- FAQs -->
      <% if (service.faqs && service.faqs.length > 0) { %>
        <div style="margin-top:64px; border-top:1px solid var(--slate-200); padding-top:48px;">
          <div class="section-header text-left">
            <span class="eyebrow">Engineering FAQs</span>
            <h3 class="section-title">Frequently Asked Questions</h3>
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px;">
            <% service.faqs.forEach(faq => { %>
              <div style="background:var(--slate-50); padding:24px; border-radius:var(--radius-md); border:1px solid var(--slate-200);">
                <h4 style="font-size:1.0625rem; color:var(--primary-navy); margin-bottom:10px;"><%= faq.question %></h4>
                <p style="font-size:0.9375rem; color:var(--slate-600); line-height:1.6;"><%= faq.answer %></p>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Reusable CTA Consultation Banner -->
  <%- include('../partials/cta-banner') %>

  <!-- Footer -->
  <%- include('../partials/footer') %>
</body>
</html>
