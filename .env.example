# Server Configuration
PORT=3000
NODE_ENV=development

# Nodemailer SMTP Configuration
# For production, enter your SMTP server credentials below:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@reinwerk-cleanroom.com
SMTP_PASS=your_smtp_password_here

# Notification Receiver (where contact and quote requests are delivered)
CONTACT_RECEIVER_EMAIL=inquiry@reinwerk-cleanroom.com
